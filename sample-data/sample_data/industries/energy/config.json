            "Orifice Flow Meter",
            "Pressure Gauge",
            "Filter Element",
            "Linear Actuator",
            "Roller Bearing",
            "Gasket Kit",
            "Relief Valve",
            "Temperature Transmitter"
          ]
        },
        {
          "name": "unit_of_measure",
          "type": "choice",
          "values": ["ea", "ea", "ea", "ea", "ea", "ea", "ea", "set", "ea", "ea"]
        },
        { "name": "lead_time_days", "type": "int_range", "min": 2, "max": 90 },
        { "name": "unit_cost", "type": "float_range", "min": 25, "max": 12000, "round": 2 }
      ]
    },
    "customers": {
      "description": "Companies that contract or purchase from NorthGrid.",
      "volume": 250,
      "fields": [
        { "name": "customer_id", "type": "id", "prefix": "CUS", "padding": 5 },
