            "Pipeline Technician",
            "Maintenance Engineer",
            "Control Room Operator",
            "Field Supervisor",
            "HSE Inspector",
            "Roustabout",
            "Geoscientist"
          ]
        },
        {
          "name": "department",
          "type": "choice",
          "values": ["Drilling", "Production", "Operations", "Maintenance", "HSE", "Geoscience", "Operations"]
        },
        {
          "name": "shift_pattern",
          "type": "choice",
          "values": ["Day", "Night", "Rotating 5x2", "Rotating 4x4", "Office"]
        }
      ]
    },
    "part_types": {
      "description": "Replacement parts and components held in inventory.",
      "volume": 10,
      "fields": [
        { "name": "part_type_id", "type": "id", "prefix": "PRT", "padding": 2 },
        {
          "name": "part_name",
          "type": "choice",
          "values": [
            "Ball Valve",
