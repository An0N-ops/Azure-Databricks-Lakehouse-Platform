{
  "metadata": {
    "industry": "energy",
    "company": "NorthGrid Resources",
    "domain": "Oil & Gas / Energy",
    "description": "Fictional oil & gas operator: customers, locations, assets, employees, inventory, work orders, maintenance, weather, and IoT telemetry. All names and values are synthetic; no real organizations or people are referenced.",
    "generator_version": "0.1.0",
    "default_start_date": "2024-01-01",
    "default_end_date": "2026-07-31"
  },
  "entities": {
    "regions": {
      "description": "Operating basins and regions.",
      "volume": 6,
      "fields": [
        { "name": "region_id", "type": "id", "prefix": "RGN", "padding": 2 },
        {
          "name": "region_name",
          "type": "choice",
          "values": ["Gulf of Mexico", "Permian Basin", "Gulf Coast", "North Sea", "Alberta", "Mid-Continent"]
        },
        {
          "name": "country",
          "type": "choice",
          "values": ["United States", "United States", "United States", "United Kingdom", "Canada", "United States"]
        },
        {
          "name": "region_type",
          "type": "choice",
          "values": ["Offshore", "Onshore", "Onshore", "Offshore", "Onshore", "Onshore"]
        },
        { "name": "is_active", "type": "constant", "value": true }
      ]
    },
    "asset_types": {
      "description": "Classes of physical assets the company operates.",
      "volume": 8,
      "fields": [
        { "name": "asset_type_id", "type": "id", "prefix": "AST", "padding": 2 },
        {
          "name": "asset_type_name",
          "type": "choice",
          "values": [
            "Drilling Rig",
            "Production Well",
            "Compressor Station",
            "Pipeline Segment",
            "Storage Tank",
            "Refinery Unit",
            "Pump Station",
            "LNG Facility"
          ]
        },
        {
          "name": "asset_category",
          "type": "choice",
          "values": ["Upstream", "Upstream", "Midstream", "Midstream", "Midstream", "Downstream", "Midstream", "Downstream"]
        },
        { "name": "typical_lifetime_years", "type": "int_range", "min": 15, "max": 40 },
        {
          "name": "criticality",
          "type": "choice",
          "values": ["CRITICAL", "HIGH", "HIGH", "MEDIUM", "MEDIUM", "LOW"]
        }
      ]
    },
    "work_order_statuses": {
      "description": "Allowed lifecycle statuses for work orders.",
      "volume": 6,
      "fields": [
        {
          "name": "status_code",
          "type": "choice",
          "values": ["OPEN", "SCHEDULED", "IN_PROGRESS", "COMPLETED", "ON_HOLD", "CANCELLED"]
        },
        {
          "name": "status_name",
          "type": "choice",
          "values": ["Open", "Scheduled", "In Progress", "Completed", "On Hold", "Cancelled"]
        },
        { "name": "is_active", "type": "constant", "value": true }
      ]
    },
    "employee_roles": {
      "description": "Job roles held by employees.",
      "volume": 9,
      "fields": [
