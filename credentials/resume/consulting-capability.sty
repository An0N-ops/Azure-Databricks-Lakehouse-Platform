% ---------------- Colour palette ------------------------------------
% Quiet, low-saturation business palette. One accent for headings and
% rules only; body is near-black for pace.
\definecolor{ink}{HTML}{1F2328}          % near-black body text
\definecolor{accent}{HTML}{1E3A5F}       % deep slate blue
\definecolor{rules}{HTML}{C9CDD6}        % soft grey separators
\definecolor{muted}{HTML}{5A6472}        % secondary text (dates, caps)

% ---------------- Hyperlinks ----------------------------------------
\hypersetup{
  colorlinks = true,
  urlcolor   = accent,
  linkcolor  = accent,
  pdftitle   = {Gaurav Sahu, Azure Data Engineer and Data Platform Consultant},
  pdfauthor  = {Gaurav Sahu},
  pdfsubject = {Independent data platform consulting capability}
}

