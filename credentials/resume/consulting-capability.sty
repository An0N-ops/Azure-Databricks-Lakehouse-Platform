% ---------------- Command: centered identity header ----------------------
% \candidate{name}{title}{descriptor}{specialization}
\newcommand{\candidate}[4]{%
  {\color{rules}\hrule height 0.5pt}\par
  \vspace{0.4em}
  {\centering
    {\sffamily\bfseries\fontsize{22}{26}\selectfont\color{ink} #1}\par
    \vspace{2.5pt}
    {\sffamily\bfseries\fontsize{12.5}{15}\selectfont\color{accent} #2}\par
    \vspace{2pt}
    {\sffamily\color{muted}\fontsize{10}{13}\selectfont #3}\par
    \vspace{1.5pt}
    {\sffamily\color{muted}\fontsize{9}{12}\selectfont #4}\par
    \vspace{2pt}
  }
  {\color{rules}\hrule height 0.5pt}\par
  \vspace{0.3em}}

% ---------------- Command: contact line -----------------------------------
% \contact{location}{phone}{email}{gh-label}{gh-url}{repo-label}{repo-url}
\newcommand{\contact}[7]{%
  \begin{center}
    {\sffamily\small\bfseries #1}\quad\textcolor{rules}{\textperiodcentered}\quad
    \href{tel:#2}{#2}\quad\textcolor{rules}{\textperiodcentered}\quad
    \href{mailto:#3}{#3}\par
    \vspace{2pt}
    {\sffamily\small\href{#5}{#4}}\quad\textcolor{rules}{\textperiodcentered}\quad
    {\sffamily\small\href{#7}{#6}}\par
  \end{center}}

% ---------------- Command: section heading -------------------------------
% \csection{Title}
\newcommand{\csection}[1]{%
  \par\vspace{0.5em}
  { \sffamily\bfseries\color{accent}\fontsize{10.5}{12}\selectfont
    \textls[65]{\MakeUppercase{#1}}}\par
  \vspace{0.14em}{\color{rules}\hrule height 0.5pt}\par
  \vspace{0.3em}}

% ---------------- Command: two-column "label : value" item ---------------
% \techline{label}{comma-separated items}
\newcommand{\techline}[2]{%
  \noindent
  \parbox[t]{0.23\textwidth}{\sffamily\small\color{muted}#1}%
  \parbox[t]{0.74\textwidth}{\small #2}\par
  \vspace{0.25em}}

% ---------------- Command: service category ------------------------------
% \service{name}{itemized content}
\newcommand{\service}[2]{%
  \noindent{\sffamily\bfseries\small\color{accent} #1}\par
  \vspace{0.08em}
  \begin{itemize}[leftmargin=1.2em, itemsep=0.5pt, topsep=0.5pt, parsep=0.5pt]
    #2
  \end{itemize}
  \vspace{0.1em}}

% ---------------- Command: engagement block ------------------------------
% \engagement{title}{meta}  then body, \impact{}, \stack{}
\newcommand{\engagement}[2]{%
  \noindent{\sffamily\bfseries\small #1}\hfill
    {\sffamily\small\color{muted}\itshape #2}\par
  \vspace{0.1em}}
\newcommand{\impact}[1]{%
  \small\noindent\textbf{Impact:}\enspace #1\par\vspace{0.05em}}
\newcommand{\stack}[1]{%
  \small\noindent\textbf{Stack:}\enspace{\color{muted}#1}\par\vspace{0.35em}}

% ---------------- Command: professional experience row -------------------
% \role{title}{dates}{organisation}
\newcommand{\role}[3]{%
  \noindent{\sffamily\bfseries\small #1}\hfill
    {\sffamily\small\color{muted} #2}\par
  \noindent{\sffamily\small\color{muted} #3}\par
  \vspace{0.2em}}

% ---------------- Command: verification placeholder ------------------------
% Swap to \href{<url>}{[Verify]} once real URLs are supplied.
\newcommand{\verify}{\textcolor{accent}{[Verify]}}