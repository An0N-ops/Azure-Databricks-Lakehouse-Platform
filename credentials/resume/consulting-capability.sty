%------------------------------------------------------------------%
%	CONSULTING CAPABILITY STATEMENT -- STYLE
%	Separates visual design from content. Source it from the main
%	.tex so every "fill in your details" edit stays in one place.
%------------------------------------------------------------------%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{capability}[2026/08 Azure Databricks consulting profile]

% ---------------- Core packages ------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[margin=1.55cm, top=1.5cm, bottom=1.4cm]{geometry}
\RequirePackage{mathpazo}                % Palatino for body (premium feel)
\RequirePackage[scaled=0.92]{helvet}     % Helvetica for headings/labels
\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{ragged2e}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{etoolbox}

% ---------------- Colour palette -----------------------------------
% Quiet, low-saturation business palette. One accent for headings /
% rules only -- body is near-black for pace.
\definecolor{ink}{HTML}{1F2328}          % near-black body text
\definecolor{accent}{HTML}{1E3A5F}       % deep slate blue
\definecolor{rules}{HTML}{C9CDD6}        % soft grey separators
\definecolor{muted}{HTML}{5A6472}        % secondary text (dates, caps)

% ---------------- Hyperlinks -----------------------------------------
\hypersetup{
  colorlinks   = true,
  urlcolor     = accent,
  linkcolor    = accent,
  pdftitle     = {Gaurav Sahu - Azure Databricks Consulting},
  pdfauthor    = {Gaurav Sahu},
  pdfsubject   = {Azure Databricks independent consulting capability}
}

\setlength{\parindent}{0pt}
\setlength{\parskip}{3pt}

% ---------------- Command: centered identity header ----------------------
% \candidate{name}{title-a}{title-b}
\newcommand{\candidate}[3]{%
  {\centering
    {\sffamily\bfseries\fontsize{24}{28}\selectfont #1}\par
    \vspace{4pt}
    {\sffamily\fontsize{11.5}{14}\selectfont #2}\par
    {\sffamily\color{muted}\fontsize{10}{14}\selectfont #3}\par
    \vspace{3pt}
  }}

% ---------------- Command: contact line (separators) ---------------------
% \contact{location}{cell}{email}{github}{repo}{portfolio}
\newcommand{\contact}[6]{%
  \begin{center}
    {\sffamily\small\bfseries #1}\quad\textcolor{rules}{\small |}\quad
    \href{tel:#2}{#2}\quad\textcolor{rules}{\small |}\quad
    \href{mailto:#3}{#3}\quad\textcolor{rules}{\small |}\quad
    \href{#4}{#4}\par
    \vspace{2pt}
    {\sffamily\small\href{#5}{#5}}\quad\textcolor{rules}{\small |}\quad
    {\sffamily\small\href{#6}{\textit{portfolio}}}
    \par\vspace{2pt}
  \end{center}}

% ---------------- Command: section heading ----------------------------
% \csection{Title}
\newcommand{\csection}[1]{%
  \par\vspace{1.15em}
  { \sffamily\bfseries\scshape\color{accent}\fontsize{11}{13}\selectfont
    \MakeUppercase{#1}}\par
  \vspace{0.25em}{\color{rules}\hrule height 0.55pt}\par
  \vspace{0.6em}}

% ---------------- Command: two-column "label : value" item ----------------
% \techline{label}{comma-separated items}
\newcommand{\techline}[2]{%
  \noindent
  \parbox[t]{0.27\textwidth}{\sffamily\small\color{muted}\scshape #1}
  \parbox[t]{0.73\textwidth}{\small #2}\par
  \vspace{0.4em}}

% ---------------- Command: grouped service --------------------------------
% \service{name}{detail}
\newcommand{\service}[2]{%
  \noindent\textbf{#1} --- #2%
  \vspace{0.35em}\par}

% ---------------- Command: engagement block --------------------------------
% \engagement{title}{meta}{tech}
\newcommand{\engagement}[3]{%
  \noindent{\sffamily\bfseries\small #1}\hfill
    {\sffamily\small\color{muted} #2}\par
  \vspace{0.25em}
  {\small #3}\par\vspace{0.6em}}