{
  "datasets": [
    {
      "columns": [
        {
          "description": "Work orders not yet completed",
          "displayName": "Open Work Orders",
          "expression": "SUM(CASE WHEN `status_code` <> 'COMPLETED' THEN 1 ELSE 0 END)"
        },
        {
          "description": "Share of work orders completed",
          "displayName": "Completion Rate %",
          "expression": "SUM(CASE WHEN `status_code` = 'COMPLETED' THEN 1 ELSE 0 END) * 1.0 / COUNT(`work_order_id`)"
        }
      ],
      "displayName": "Work Orders",
      "name": "ds_work",
      "queryLines": [
        "SELECT fo.work_order_id, fo.status_code, fo.priority, fo.work_type,\n",
        "       CAST(fo.planned_hours AS DOUBLE) AS planned_hours,\n",
        "       CAST(fo.actual_hours AS DOUBLE) AS actual_hours,\n",
        "       CAST(fo.opened_at AS DATE) AS work_date,\n",
        "       dl.region_id, dr.region_name\n",
        "FROM fact_work_order fo\n",
        "LEFT JOIN dim_location dl ON fo.location_id = dl.location_id\n",
        "LEFT JOIN dim_region dr ON dl.region_id = dr.region_id\n"
      ]
    },
    {
      "columns": [
        {
          "description": "Sum of maintenance spend",
          "displayName": "Total Maintenance Cost",
          "expression": "SUM(`maintenance_cost`)"
        },
        {
          "description": "Sum of downtime from maintenance events",
          "displayName": "Total Downtime Hours",
          "expression": "SUM(`downtime_hours`)"
        }
      ],
      "displayName": "Maintenance Events",
      "name": "ds_maint",
      "queryLines": [
        "SELECT me.event_id, me.event_type, me.root_cause,\n",
        "       CAST(me.downtime_hours AS DOUBLE) AS downtime_hours,\n",
        "       CAST(me.maintenance_cost AS DOUBLE) AS maintenance_cost,\n",
        "       CAST(me.detected_at AS DATE) AS detected_date,\n",
        "       dl.region_id, dr.region_name\n",
        "FROM fact_maintenance_event me\n",
        "LEFT JOIN dim_asset a ON me.asset_id = a.asset_id\n",
        "LEFT JOIN dim_location dl ON a.location_id = dl.location_id\n",
        "LEFT JOIN dim_region dr ON dl.region_id = dr.region_id\n"
      ]
    },
    {
      "columns": [
        {
          "description": "Sum of daily alert counts",
          "displayName": "Total Sensor Alerts",
          "expression": "SUM(`alert_count`)"
        }
      ],
      "displayName": "Sensor Readings",
      "name": "ds_sensor",
      "queryLines": [
        "SELECT s.asset_id, s.sensor_type, s.avg_reading, s.alert_count,\n",
        "       TO_DATE(CAST(s.date_key AS STRING), 'yyyyMMdd') AS sensor_date,\n",
        "       dl.region_id, dr.region_name\n",
        "FROM fact_sensor_daily s\n",
        "LEFT JOIN dim_asset a ON s.asset_id = a.asset_id\n",
        "LEFT JOIN dim_location dl ON a.location_id = dl.location_id\n",
        "LEFT JOIN dim_region dr ON dl.region_id = dr.region_id\n"
      ]
    },
    {
      "displayName": "Weather Observations",
      "name": "ds_weather",
      "queryLines": [
        "SELECT w.weather_id, w.condition,\n",
        "       CAST(w.temperature_c AS DOUBLE) AS temperature_c,\n",
        "       CAST(w.precipitation_mm AS DOUBLE) AS precipitation_mm,\n",
        "       CAST(w.humidity_pct AS DOUBLE) AS humidity_pct,\n",
        "       CAST(w.observed_date AS DATE) AS observed_date,\n",
        "       dl.region_id, dr.region_name\n",
        "FROM fact_weather_daily w\n",
        "LEFT JOIN dim_location dl ON w.location_id = dl.location_id\n",
        "LEFT JOIN dim_region dr ON dl.region_id = dr.region_id\n"
      ]
    }
  ],
